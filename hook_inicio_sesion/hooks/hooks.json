{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/scripts/inicio-sesion.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
