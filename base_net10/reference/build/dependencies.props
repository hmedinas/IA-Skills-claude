<Project>
  <!-- Configuración global de SDK, MSBuild y otros elementos -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Versiones comunes para dependencias usadas en más de un proyecto -->
  <ItemGroup>
    <PackageReference Update="MediatR" Version="12.4.1" />
    <PackageReference Update="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Update="StyleCop.Analyzers" Version="1.1.118" />
  </ItemGroup>
</Project>
