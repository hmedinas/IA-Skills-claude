{
  "AllowedCorsOrigins": [
    "https://localhost:3000",
    "http://localhost:3000"
  ],
  "urlApp": "https://localhost:5081/",
  "ConnectionStrings": {
    //"DefaultConnection": "Data Source=SERVIDOR;Initial Catalog=__Database__;User Id=usuario;Password=EN_SECRETS;TrustServerCertificate=True;Encrypt=False;",
    "TimeOutConnection": "180"
  },
  "AppSettings": {
    "MaxFileLenght": 5242880
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "MediatR": "Debug"
    }
  },
  "ApplicationName": "__Aplicacion__",
  "PathBase": "",
  "AllowedHosts": "*",
  //JWT
  "Jwt": {
    "Issuer": "__Aplicacion__",
    "Audience": "API",
    //"SecretKey": "EN_SECRETS",
    "Expires": 60,
    "ExpiresRefresh": 10
    //"KeyEncrypt": "EN_SECRETS",
    //"IvEncrypt": "EN_SECRETS"
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Project": "__RootNamespace__.Host",
      "Environment": "DEV",
      "Application": "__Aplicacion__-API"
    }
  },
  "SwaggerAvailable": true
}
